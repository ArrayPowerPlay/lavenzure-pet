# DEVELOPMENT ONLY. The packaged app takes its keys from Settings (tray icon > Settings), where they
# are checked and kept in the Windows Credential Manager. Keys set here (in a .env file) or as
# environment variables override the saved ones. Never commit the real .env file.

# Google AI Studio Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI API key (https://platform.openai.com/api-keys), used when Settings > Chat AI is OpenAI
OPENAI_API_KEY=

# Tavily web search API key (https://tavily.com), optional: lets the pet search the web
TAVILY_API_KEY=
